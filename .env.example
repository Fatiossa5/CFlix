# Copy to .env on this computer. Never commit .env or share SMTP credentials.
HOST=0.0.0.0
PORT=3000
# Local HTTP only. Compose overrides these for HTTPS production.
COOKIE_SECURE=0
PUBLIC_ORIGIN=
TRUSTED_PROXY_CIDRS=
MAX_CONNECTIONS=64
SMTP_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
FEEDBACK_RECIPIENT=
SMTP_STARTTLS=1
SMTP_SSL=0
# SMTP_PASSWORD must be a Google App Password, not the account password.
# Required for Docker HTTPS: real DNS hostname, without scheme/path/port.
# Leave blank for local development. No public domain has been provisioned.
CFLIX_DOMAIN=
# Optional: change only when selecting another persistent volume (e.g. restore).
# CFLIX_DATA_VOLUME=fatihflix_data
